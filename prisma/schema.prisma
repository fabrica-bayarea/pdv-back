//Model das entidades

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id   Int    @id @default(autoincrement())
  nome String
}

// Entidades relacionadas a Usuários e Clientes
model Usuario {
  id           Int        @id @default(autoincrement())
  nome         String
  email        String     @unique
  senha        String
  dataCriacao  DateTime   @default(now())
  carrinhos    Carrinho[]
}

model Cliente {
  id              Int        @id @default(autoincrement())
  cpf             String
  email           String     @unique
  nome            String
  telefone        String
  endereco        String
  dataNascimento  DateTime
  dataCriacao     DateTime   @default(now())
  carrinhos       Carrinho[]
  vendas          Venda[]
}

// Entidades relacionadas a Vendedores e Vendas
model Vendedor {
  id             Int      @id @default(autoincrement())
  cpf            String   @unique
  email          String   @unique
  nome           String
  telefone       String?
  endereco       String?
  dataNascimento DateTime
  vendas         Venda[]
}

model Venda {
  id         Int       @id @default(autoincrement())
  clienteId  Int
  vendedorId Int
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  vendedor   Vendedor  @relation(fields: [vendedorId], references: [id])

  @@unique([clienteId, vendedorId])
}

// Entidades relacionadas a Produtos e Fornecedores
model Fornecedor {
  id                 Int       @id @default(autoincrement())
  nomeFantasia       String
  cnpj               String    @unique
  tipoPessoa         String
  inscricaoEstadual  String
  razaoSocial        String
  dataRegistro       DateTime
  produtos           Produto[]
  dataCriacao        DateTime  @default(now())
}

model Produto {
  id             Int            @id @default(autoincrement())
  nome           String
  marca          String
  descricao      String
  fornecedorId   Int
  codigoProduto  String         @unique
  categoriaId    Int
  unidadeMedida  String
  preco          Float
  estoqueAtual   Float
  categoria      Categoria      @relation(fields: [categoriaId], references: [id])
  fornecedor     Fornecedor     @relation(fields: [fornecedorId], references: [id])
  estoque        Estoque[]      
  dataCriacao    DateTime       @default(now())
  itensCarrinho  ItemCarrinho[]
}

// Entidades relacionadas a Carrinho e Itens do Carrinho
model Carrinho {
  id        Int            @id @default(autoincrement())
  cliente   Cliente        @relation(fields: [clienteId], references: [id])
  usuario   Usuario?       @relation(fields: [usuarioId], references: [id])
  clienteId Int
  usuarioId Int?
  itens     ItemCarrinho[]
  subtotal  Float
}

model ItemCarrinho {
  id             Int        @id @default(autoincrement())
  produto        Produto    @relation(fields: [produtoId], references: [id])
  produtoId      Int
  quantidade     Int
  carrinho       Carrinho   @relation(fields: [carrinhoId], references: [id])
  carrinhoId     Int
}

// Entidades de produto e estoque
model Categoria {
  id           Int       @id @default(autoincrement())
  nome         String
  dataCriacao  DateTime  @default(now())
  produtos     Produto[]
}

model Estoque {
  id                Int        @id @default(autoincrement())
  produtoId         Int       
  produto           Produto    @relation(fields: [produtoId], references: [id]) 
  quantidade        Int
  localizacao       String?   
  dataValidade      DateTime?  
  lote              String?    
  precoCompra       Float?     
  precoVenda        Float?     
  fornecedorId      Int?       
  dataAtualizacao   DateTime   @default(now())

  @@unique([produtoId])
}

// Entidades de solicitação e registro
model ProdutoSolicitacao {
  id                  Int     @id @default(autoincrement())
  solicitacaoCompraId Int
  codigoProduto      String
  quantidade         Int
  controle           String?
  descricao          String?
}

model RegistroProduto {
  id               Int      @id @default(autoincrement())
  nome             String
  descricaoProduto String
  marca            String
  unidadeMedida    String
  estoqueAtual     String
  preco            Float
  fornecedor       String
  codigoProduto    String
  dataCadastro     DateTime
}

// Entidade de contagem mensal e produto contado 
model ContagemMensal {
  id               Int       @id @default(autoincrement())
  mes              Int
  ano              Int
  localizacao      String?
  responsavel      String
  dataHoraContagem DateTime
  observacoes      String?

  produtos         ProdutoContado[]
}

model ProdutoContado {
  id         Int      @id @default(autoincrement())
  nome       String
  codigo     String
  quantidade Float
  contagem   ContagemMensal @relation(fields: [contagemId], references: [id])
  contagemId Int
}

// Entidades de finalizadores
model Finalizador {
  id           Int      @id @default(autoincrement())
  codigo       String
  nome         String
  situacao     String
  grupoReceita String
  bandeira     String
  dataCriacao  DateTime @default(now())
}

// Entidades de compra e notas fiscais

model SolicitacaoCompra {
  id         Int     @id @default(autoincrement())
  clienteId  Int
  vendedorId Int
  ativo      Boolean
  observacao String?
}

model Item {
  id            Int    @id @default(autoincrement())
  codigoProduto String @unique
  nomeProduto   String
  unidadeMedida String
  valorUnitario Float
  grupoItem     String
  grupoDespesa  String
  despesa       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model NotaFiscalEntrada {
  id                  Int       @id @default(autoincrement())
  numeroNota          String    @unique
  dataEmissao         DateTime
  serie               String?
  valorTotal          Float
  valorImpostos       Float
  condicoesPagamento  String?
  prazoEntrega        String?
  observacoes         String?
  emitenteId          Int 
  destinatarioId      Int
  emitente            Emitente  @relation(fields: [emitenteId], references: [id])
  destinatario        Destinatario  @relation(fields: [destinatarioId], references: [id])
  produtos            ProdutoNota[]
}

model Emitente {
  id             Int       @id @default(autoincrement())
  nome           String
  identificacao  String    @unique 
  endereco       String
  notasFiscais   NotaFiscalEntrada[]
}

model Destinatario {
  id             Int       @id @default(autoincrement())
  nome           String
  identificacao  String    @unique 
  endereco       String
  notasFiscais   NotaFiscalEntrada[]
}

model ProdutoNota {
  id         Int      @id @default(autoincrement())
  descricao  String
  quantidade Float
  precoUnit  Float
  total      Float
  nota       NotaFiscalEntrada @relation(fields: [notaId], references: [id])
  notaId     Int
}

model NotaFiscal {
  id           Int      @id @default(autoincrement())
  tipoDeNota   String
  modelo       String
  fornecedorId Int
  dataEntrada  DateTime @default(now())
  numeroDaNota String
  dataEmissao  DateTime @default(now())
}
