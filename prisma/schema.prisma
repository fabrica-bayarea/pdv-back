//Model das entidades

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id      Int        @id @default(autoincrement())
  nome    String     @unique
  usuarios UsuarioRole[]
}

model Usuario {
  id           Int          @id @default(autoincrement())
  nome         String
  email        String       @unique
  senha        String
  data_criacao DateTime     @default(now())
  Carrinho     Carrinho[]
  roles        UsuarioRole[]
}

model UsuarioRole {
  id        Int      @id @default(autoincrement())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId Int
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    Int

  @@unique([usuarioId, roleId])
}

model Cliente {
  id              Int        @id @default(autoincrement())
  cpf             String
  email           String     @unique
  nome            String
  telefone        String
  endereco        String
  data_nascimento DateTime
  data_criacao    DateTime   @default(now())
  Carrinho        Carrinho[]
  vendas          Venda[]
  enderecos       Endereco[]  @relation("EnderecoCliente")
}

// Entidades relacionadas a Vendedores e Vendas
model Vendedor {
  id              Int      @id @default(autoincrement())
  cpf             String   @unique
  email           String   @unique
  nome            String
  telefone        String?
  endereco        String?
  dataNascimento DateTime
  vendas          Venda[]
}

model Venda {
  id         Int       @id @default(autoincrement())
  clienteId  Int
  vendedorId Int
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  vendedor   Vendedor  @relation(fields: [vendedorId], references: [id])

  @@unique([clienteId, vendedorId])
}

// Entidades relacionadas a Produtos e Fornecedores
model Fornecedor {
  id                  Int       @id @default(autoincrement())
  nome_fantasia       String
  cnpj                String    @unique
  tipo_pessoa         String
  inscricao_estadual  String
  razao_social        String
  data_registro       DateTime
  produtos            Produto[]   // Relação com Produto
  data_criacao        DateTime  @default(now())
}

model Produto {
  id               Int            @id @default(autoincrement())
  nome             String
  marca            String
  descricao        String
  id_fornecedor    Int
  codigo_produto   String         @unique
  id_categoria     Int
  unidade_medida   String
  preco            Float
  estoque_atual    Float
  categoria        Categoria      @relation(fields: [id_categoria], references: [id])
  fornecedor       Fornecedor     @relation(fields: [id_fornecedor], references: [id])
  estoque          Estoque[]      
  data_criacao     DateTime       @default(now())
  itensCarrinho    ItemCarrinho[]
  ficha_tecnica    FichaTecnicaProduto?
}

model FichaTecnicaProduto {
  id               Int      @id @default(autoincrement())
  dimensoes        String?
  peso             String?
  material         String?
  outras_especificacoes String?
  caracteristicas  String
  funcionalidades  String
  instrucoes_uso   String
  manutencao       String
  certificacoes    String
  data_elaboracao  DateTime @default(now())

  produto          Produto  @relation(fields: [produtoId], references: [id])
  produtoId        Int      @unique
}


// Entidades relacionadas a Carrinho
model Carrinho {
  id               Int             @id @default(autoincrement())
  cliente          Cliente         @relation(fields: [clienteId], references: [id])
  usuario          Usuario?        @relation(fields: [usuarioId], references: [id])
  clienteId        Int
  usuarioId        Int?
  itens            ItemCarrinho[]
  descontos        Desconto[]
  total            Float
  impostos         Float?
  metodoPagamento  MetodoPagamento?  @relation(fields: [metodoPagamentoId], references: [id])
  metodoPagamentoId  Int?
  enderecoEntrega  EnderecoEntrega? @relation(fields: [enderecoEntregaId], references: [id])
  enderecoEntregaId Int?
  createdAt        DateTime        @default(now())
}

model ItemCarrinho {
  id             Int        @id @default(autoincrement())
  produto        Produto    @relation(fields: [produtoId], references: [id])
  produtoId      Int
  quantidade     Int
  carrinho       Carrinho   @relation(fields: [carrinhoId], references: [id])
  carrinhoId     Int
}

model Desconto {
  id            Int         @id @default(autoincrement())
  carrinho      Carrinho    @relation(fields: [carrinhoId], references: [id])
  carrinhoId    Int
  valor         Float       
  motivo        String      
}

model MetodoPagamento {
  id              Int         @id @default(autoincrement())
  tipo            String
  carrinhos       Carrinho[]  
}

model Endereco {
  id             Int         @id @default(autoincrement())
  rua            String
  cidade         String
  estado         String
  pais           String
  cep            String
  cliente        Cliente     @relation("EnderecoCliente", fields: [clienteId], references: [id])
  clienteId      Int
}

model EnderecoEntrega {
  id       Int      @id @default(autoincrement())
  cep      String
  rua      String
  cidade   String
  estado   String
  pais     String
  carrinho Carrinho[]
}

// Entidades de produto e estoque
model Categoria {
  id           Int       @id @default(autoincrement())
  nome         String
  data_criacao DateTime  @default(now())
  produtos     Produto[]
}

model Estoque {
  id                Int        @id @default(autoincrement())
  produtoId         Int       
  produto           Produto    @relation(fields: [produtoId], references: [id]) 
  quantidade        Int
  localizacao       String?   
  dataValidade      DateTime?  
  lote              String?    
  precoCompra       Float?     
  precoVenda        Float?     
  id_fornecedor     Int?       
  dataAtualizacao   DateTime   @default(now())

  @@unique([produtoId])
}

// Entidades de solicitação e registro
model ProdutoSolicitacao {
  id                  Int     @id @default(autoincrement())
  solicitacaoCompraId Int
  codigo_produto      String
  quantidade          Int
  controle            String?
  descricao           String?
}

model RegistroProduto {
  id               Int      @id @default(autoincrement())
  nome             String
  descricaoProduto String
  marca            String
  unidade_medida   String
  estoque_atual    String
  preco            Float
  fornecedor       String
  codigo_produto   String
  dataCadastro     DateTime
}

// Entidade de contagem mensal e produto contado 
model ContagemMensal {
  id               Int       @id @default(autoincrement())
  mes              Int
  ano              Int
  localizacao      String?
  responsavel      String
  dataHoraContagem DateTime
  observacoes      String?

  produtos         ProdutoContado[]
}

model ProdutoContado {
  id         Int            @id @default(autoincrement())
  nome       String
  codigo     String
  quantidade Float
  contagem   ContagemMensal @relation(fields: [contagemId], references: [id])
  contagemId Int
}

// Entidades de finalizadores
model Finalizador {
  id           Int      @id @default(autoincrement())
  codigo       String
  nome         String
  situacao     String
  grupoReceita String
  bandeira     String
  data_criacao DateTime @default(now())
}

// Entidades de compra e notas fiscais

model SolicitacaoCompra {
  id         Int     @id @default(autoincrement())
  clienteId  Int
  vendedorId Int
  ativo      Boolean
  observacao String?
}

model Item {
  id             Int    @id @default(autoincrement())
  codigo_produto String @unique
  nomeProduto    String
  unidade_medida String
  valorUnitario  Float
  grupoItem      String
  grupoDespesa   String
  despesa        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model NotaFiscalEntrada {
  id                  Int       @id @default(autoincrement())
  numeroNota          String    @unique
  dataEmissao         DateTime
  serie               String?
  valorTotal          Float
  valorImpostos       Float
  condicoesPagamento  String?
  prazoEntrega        String?
  observacoes         String?
  emitenteId          Int 
  destinatarioId      Int
  emitente            Emitente  @relation(fields: [emitenteId], references: [id])
  destinatario        Destinatario  @relation(fields: [destinatarioId], references: [id])
  produtos            ProdutoNota[]
}

model Emitente {
  id             Int       @id @default(autoincrement())
  nome           String
  identificacao  String    @unique 
  endereco       String
  notasFiscais   NotaFiscalEntrada[]
}

model Destinatario {
  id             Int       @id @default(autoincrement())
  nome           String
  identificacao  String    @unique 
  endereco       String
  notasFiscais   NotaFiscalEntrada[]
}

model ProdutoNota {
  id         Int      @id @default(autoincrement())
  descricao  String
  quantidade Float
  precoUnit  Float
  total      Float
  nota       NotaFiscalEntrada @relation(fields: [notaId], references: [id])
  notaId     Int
}

model NotaFiscal {
  id            Int      @id @default(autoincrement())
  tipoDeNota    String
  modelo        String
  id_fornecedor Int
  dataEntrada   DateTime @default(now())
  numeroDaNota  String
  dataEmissao   DateTime @default(now())
}
